    "import numpy as np\n",
    "import datetime\n",
    "linewidth = 2\n",
    "fontsize = 12\n",
    "plt.rcParams['xtick.labelsize'] = fontsize\n",
    "plt.rcParams['ytick.labelsize'] = fontsize\n",
