    "    bins=bins,\n",
    "    fun='longitudinal',\n",
    "    bootsize={'y':64,'x':64},\n",
    "    initial_nbootstrap=60,\n",
    "    max_nbootstrap=420,\n",
    "    step_nbootstrap=40,\n",
    "    convergence_eps=1.0,\n",
    "    n_jobs=-1,\n",
    "    backend='loky'\n",
    ")"
   ]
