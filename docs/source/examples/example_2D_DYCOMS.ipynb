   "source": [
    "# Load the DYCOMS Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "d60bc01b-ff39-4a24-9e86-6faab142f056",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "29949"
      ]
     },
     "execution_count": 19,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "path_data = '/home/aayouche/Downloads/'\n",
    "idt = 10\n",
    "ds = xr.open_dataset(path_data+'dycoms.slice.9.40810.nc')\n",
    "\n",
    "u = ds.u\n",
    "v = ds.v\n",
    "b = ds.b\n",
    "dudx = u.differentiate('x')\n",
    "dudy = u.differentiate('y')\n",
    "dvdx = v.differentiate('x')\n",
    "dvdy = v.differentiate('y')\n",
    "\n",
    "adv_u = u*dudx + v*dudy\n",
    "\n",
    "adv_v = u*dvdx + v*dvdy\n",
    "\n",
    "x =  ds.x\n",
    "y = ds.y\n",
    "\n",
    "Y,X = np.meshgrid(y.values,x.values,indexing='ij')\n",
    "gc.collect()"
   ]
  },
